{
    "name": "indiesystems/laravel-notifications",
    "description": "Generic notification system for Laravel applications with AdminLTE UI - bell dropdown, full page, read/unread management, Spatie notification log integration",
    "keywords": ["laravel", "notifications", "adminlte", "bell", "dropdown", "read-unread"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Dimas",
            "email": "chris@indie.systems",
            "homepage": "https://indie.systems",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/indiesystems/laravel-notifications",
    "support": {
        "issues": "https://github.com/indiesystems/laravel-notifications/issues",
        "source": "https://github.com/indiesystems/laravel-notifications"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/notifications": "^10.0|^11.0",
        "illuminate/routing": "^10.0|^11.0",
        "spatie/laravel-notification-log": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "IndieSystems\\Notifications\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IndieSystems\\Notifications\\IndieNotificationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
